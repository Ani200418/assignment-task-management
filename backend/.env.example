# --- required ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key   # SERVER ONLY. Never expose to the browser.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000        # comma-separated explicit origins
FLASK_ENV=development
# --- Gmail sender (dedicated account; see docs/DEPLOYMENT.md). Without these, emails stay 'pending'. ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# --- shared secret for the cron retry endpoint (generate a long random string) ---
CRON_SECRET=
